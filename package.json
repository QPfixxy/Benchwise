{
  "name": "qudit",
  "productName": "Qudit",
  "version": "2.0.0",
  "description": "Lightweight ITAD hardware information and test tool for auditors and testers.",
  "main": "src/main/main.js",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/electron.js",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "node scripts/electron.js --smoke-test",
    "check:ui": "node scripts/electron.js --ui-check=out/ui-check",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:dir": "electron-builder --dir",
    "dist:mac:unsigned": "electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "systeminformation": "^5.33.23"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.qudit",
    "productName": "Qudit",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "Qudit-${version}-windows-portable.exe",
      "requestExecutionLevel": "admin"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSCameraUsageDescription": "Qudit uses the camera to run the webcam test.",
        "NSMicrophoneUsageDescription": "Qudit uses the microphone to run the microphone test."
      },
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "qudit",
      "artifactName": "Qudit-${version}-linux-${arch}.${ext}"
    },
    "asarUnpack": [
      "src/main/stress/**"
    ],
    "artifactName": "Qudit-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "artifactName": "Qudit-${version}-windows-setup.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "artifactName": "Qudit-${version}-mac-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qpfixxy/Qudit.git"
  },
  "author": "Qudit contributors",
  "homepage": "https://github.com/qpfixxy/Qudit"
}
