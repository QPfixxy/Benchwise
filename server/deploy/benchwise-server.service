[Unit]
Description=Benchwise Server
Documentation=https://github.com/QPfixxy/Benchwise/blob/main/docs/hub/DESIGN.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=benchwise-server
Group=benchwise-server
EnvironmentFile=/etc/benchwise-server/server.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/benchwise-server
ExecStart=/usr/bin/node /opt/benchwise-server/src/server.js
Restart=on-failure
RestartSec=3

# Sandbox: the service can only write its files folder, sees no home
# directories, can't gain privileges and has no capabilities at all.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/benchwise-server
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
