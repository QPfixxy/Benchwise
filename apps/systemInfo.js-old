const si = systeminformation;

async function getSystemInfo() {
    try {
        const manufacturer = await si.system.manufacturer();
        const modelName = await si.system.model();
        const serialNumber = await si.system.serial();

        const cpu = await si.cpu();
        const cpuCoreCount = cpu.cores;
        const cpuSpeed = cpu.speed;

        const memory = await si.mem();
        const ramCapacity = memory.total;
        const ramGeneration = memory.type;
        const ramEcc = memory.ecc;
        const ramSpeed = memory.clockSpeed;

        const gpu = await si.graphics();
        const gpuName = gpu.controllers[0].model;
        const gpuType = gpu.controllers[0].vendor === 'Intel' ? 'Integrated' : 'Dedicated';

        const disks = await si.diskLayout();
        const diskInfo = disks.map(disk => ({
            model: disk.name,
            capacity: disk.size,
            serialNumber: disk.serialNum
        }));

        return {
            manufacturer,
            modelName,
            serialNumber,
            cpu: {
                coreCount: cpuCoreCount,
                speed: cpuSpeed
            },
            memory: {
                capacity: ramCapacity,
                generation: ramGeneration,
                ecc: ramEcc,
                speed: ramSpeed
            },
            gpu: {
                name: gpuName,
                type: gpuType
            },
            disks: diskInfo
        };
    } catch (error) {
        throw new Error('Error collecting system information: ' + error.message);
    }
}

function generateHTMLTable(systemInfo) {
    let html = '<table border="1">';
    for (const [category, value] of Object.entries(systemInfo)) {
        html += `<tr><td>${category}</td><td>${value}</td></tr>`;
    }
    html += '</table>';
    return html;
}

module.exports = { getSystemInfo, generateHTMLTable };
